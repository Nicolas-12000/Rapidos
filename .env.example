# Copia este archivo a .env y ajusta valores. No subas .env al repo.
# Docker Compose y Spring Boot leen estas variables (ver README, sección Variables de entorno).

# --- Servidor ---
SERVER_PORT=8080

# --- PostgreSQL (app y contenedor postgres) ---
POSTGRES_DB=rapidos
POSTGRES_USER=rapidos
POSTGRES_PASSWORD=rapidos
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rapidos
SPRING_DATASOURCE_USERNAME=rapidos
SPRING_DATASOURCE_PASSWORD=rapidos

# En Docker Compose la app usa jdbc:postgresql://postgres:5432/rapidos (ver docker-compose.yml).

# --- Workers de despacho (cola asíncrona) ---
RAPIDOS_WORKERS_CORE_SIZE=2
RAPIDOS_WORKERS_MAX_SIZE=4
RAPIDOS_WORKERS_QUEUE_CAPACITY=100

# --- Menú (caché en pedidos) ---
MENU_CACHE_TTL=5m

# --- Persistencia por módulo (adaptadores; el aplicativo no lee esto) ---
# Pedidos, despacho y menú → Postgres vía SPRING_DATASOURCE_* (arriba).
# Ubicación GPS (ADR-002): memoria | firebase
RAPIDOS_PERSISTENCIA_UBICACION=memoria
UBICACION_TTL_SEGUNDOS=30
UBICACION_VENTANA_MEDIDAS=20
UBICACION_MINIMO_MEDICIONES=5

# Firebase Realtime Database (solo si RAPIDOS_PERSISTENCIA_UBICACION=firebase)
FIREBASE_DB_URL=
FIREBASE_AUTH_TOKEN=
FIREBASE_TIMEOUT_MS=2000
