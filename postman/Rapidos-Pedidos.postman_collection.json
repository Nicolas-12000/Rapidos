{
  "info": {
    "_postman_id": "a1b2c3d4-pedidos-rapidos-0001",
    "name": "Rapidos — Pedidos (Dev 1 + Dev 5)",
    "description": "Módulo `pedidos` (unificado): cola Modulith, crear pedido, idempotencia y consulta.\n\nRequisitos:\n1. `docker compose up -d`\n2. App en {{baseUrl}}\n3. Header obligatorio: `Idempotency-Key`\n4. Catálogo con restaurante {{restauranteId}} e ítem {{itemId}} (ver colección Catálogo)\n\nOrden sugerido: cola → POST crear → POST misma llave → GET por id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET cola (eventos pendientes)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Tiene pendientes y publicaciones', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.have.property('pendientes');",
              "  pm.expect(b).to.have.property('publicaciones');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/cola"
      }
    },
    {
      "name": "POST crear pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.test('Pedido confirmado', () => pm.expect(body.estado).to.eql('CONFIRMADO'));",
              "  if (body.id) pm.environment.set('pedidoId', String(body.id));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "description": "Obligatoria"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restauranteId\": {{restauranteId}},\n  \"clienteId\": {{clienteId}},\n  \"items\": [\n    {\n      \"itemId\": {{itemId}},\n      \"cantidad\": 2\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "POST crear pedido (misma Idempotency-Key)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Mismo id (idempotencia)', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(String(body.id)).to.eql(pm.environment.get('pedidoId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restauranteId\": {{restauranteId}},\n  \"clienteId\": {{clienteId}},\n  \"items\": [\n    {\n      \"itemId\": {{itemId}},\n      \"cantidad\": 2\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "GET pedido por id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Id coincide', () => {",
              "  pm.expect(String(pm.response.json().id)).to.eql(pm.environment.get('pedidoId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
      }
    }
  ]
}
