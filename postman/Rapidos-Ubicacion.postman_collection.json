{
  "info": {
    "_postman_id": "e6f7a8b9-ubicacion-rapidos-01",
    "name": "Rapidos — Ubicación (Dev 4)",
    "description": "Módulo `ubicacion`: GPS en memoria (ADR-002). Reportar posición y consultar por pedido.\n\nRequisitos: pedido con despacho asignado al repartidor {{repartidorId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PUT reportar ubicación repartidor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lat\": 1.2136,\n  \"lon\": -77.2811\n}"
        },
        "url": "{{baseUrl}}/api/repartidores/{{repartidorId}}/ubicacion"
      }
    },
    {
      "name": "GET ubicación del pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 o 404', () => {",
              "  pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.test('Incluye frecuencia sugerida', () => {",
              "    pm.expect(pm.response.json()).to.have.property('frecuenciaSugeridaSegundos');",
              "  });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/ubicacion"
      }
    }
  ]
}
