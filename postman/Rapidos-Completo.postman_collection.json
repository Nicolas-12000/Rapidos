            },
            "url": "{{baseUrl}}/api/repartidores/{{repartidorId}}/ubicacion",
            "description": "Solo la última posición por repartidor (TTL en memoria o Firebase según config)."
          }
        },
        {
          "name": "PUT ubicación inválida (400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 999,\n  \"lon\": 0\n}"
            },
            "url": "{{baseUrl}}/api/repartidores/{{repartidorId}}/ubicacion"
          }
        },
        {
          "name": "GET última ubicación del pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/ubicacion",
            "description": "Incluye `frecuenciaSugeridaSegundos` (5 / 10 / 15) según degradación GPS."
          }
        },
        {
          "name": "GET ubicación pedido inexistente (404)",
          "request": {
