{
  "info": {
    "_postman_id": "d5e6f7a8-despacho-rapidos-01",
    "name": "Rapidos — Despacho (Dev 3)",
    "description": "Módulo `despacho`: estados del repartidor con llave única (ADR-003).\n\nRequisitos: pedido existente (`pedidoId`). Tras crear pedido, despacho asigna repartidor de forma asíncrona.\nEstados: `ASIGNADO`, `RECOGIDO`, `ENTREGADO`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST registrar estado (RECOGIDO)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": {{pedidoId}},\n  \"estado\": \"RECOGIDO\",\n  \"llave\": \"{{llaveEstado}}\"\n}"
        },
        "url": "{{baseUrl}}/api/repartidores/{{repartidorId}}/estado",
        "description": "Equivalente al curl del README. Cambia `llave` para cada transición nueva."
      }
    },
    {
      "name": "POST registrar estado (ENTREGADO)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": {{pedidoId}},\n  \"estado\": \"ENTREGADO\",\n  \"llave\": \"est-{{pedidoId}}-entregado\"\n}"
        },
        "url": "{{baseUrl}}/api/repartidores/{{repartidorId}}/estado"
      }
    }
  ]
}
